# LeaseBrief — environment variables (template).
# Copy this file to `.env.local` for local development. Production secrets are
# managed in your hosting platform (Vercel → Project → Settings → Environment).

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (database + auth) ──────────────────────────────────────────────
# Auto-injected by the Supabase Vercel Integration. Set manually only if
# using a non-Vercel hosting provider.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-api-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC secret for the /api/email/welcome-webhook signature check.
# Generate with: openssl rand -hex 32
SUPABASE_WEBHOOK_SECRET=replace-me-with-openssl-rand-hex-32

# Local-dev/CI Postgres URL — used by scripts/auto-migrate.mjs (prebuild).
# Set automatically by the Supabase Vercel Integration in production.
POSTGRES_URL_NON_POOLING=

# ─── PostHog (analytics) ─────────────────────────────────────────────────────
# Client-side publishable key (safe to expose). Server-only override:
# POSTHOG_SERVER_KEY.
NEXT_PUBLIC_POSTHOG_KEY=phc_TEAM_KEY

# ─── Stripe (payment) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me
# Sender address — set by /deploy state-3b to noreply@<domain>.
# Falls back to onboarding@resend.dev (Resend sandbox) when absent.
RESEND_FROM=onboarding@resend.dev

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Auto-set by Vercel; required for /api/email/nudge to accept cron invocations.
CRON_SECRET=replace-me-with-a-strong-random-string

# ─── AI image generation (optional) ──────────────────────────────────────────
# AI image generation via fal.ai (optional -- SVG placeholders used if absent)
FAL_KEY=

# ─── Demo mode ───────────────────────────────────────────────────────────────
# When set to "true" locally, bypasses Supabase + Stripe so the funnel walks
# end-to-end on a fresh clone without external services. Rejected at runtime
# when VERCEL === "1" — never set in production.
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true
